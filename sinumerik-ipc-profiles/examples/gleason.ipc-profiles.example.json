{
  "schemaVersion": 1,
  "defaultProfile": "gleason-standard",
  "profiles": {
    "gleason-standard": {
      "computerName": "192.168.214.241",
      "defaultRole": "administrator",
      "accounts": {
        "administrator": "GLEASON",
        "operator": "AUDUSER"
      },
      "winrm": {
        "port": 5985,
        "useSsl": false,
        "authentication": "Negotiate"
      },
      "management": {
        "clientAddress": "192.168.214.252",
        "remoteAddress": "192.168.214.0/24"
      },
      "bootstrap": {
        "remoteRoot": "D:\\OEM\\Adapter",
        "shares": [
          "D",
          "D$"
        ],
        "files": [
          {
            "source": "scripts\\setup_gleason_ipc.ps1",
            "destination": "setup_gleason_ipc.ps1"
          },
          {
            "source": "scripts\\Gleason.IpcSetup.psm1",
            "destination": "Gleason.IpcSetup.psm1"
          }
        ],
        "stateFile": "gleason_ipc_setup_state.json",
        "revertScript": "revert_gleason_ipc_setup.ps1",
        "entryScript": "setup_gleason_ipc.ps1",
        "entryArguments": {
          "IpcIp": "{computerName}",
          "RemoteAddress": "{management.remoteAddress}"
        }
      },
      "runtime": {
        "port": 8765,
        "processName": "Gleason_Collector.exe",
        "taskName": "Gleason Collector Interactive Start",
        "healthPath": "/health",
        "snapshotPath": "/snapshot",
        "activeReleaseFile": "active-release.json",
        "logFiles": [
          "logs\\collector.error.log",
          "logs\\collector.output.log"
        ]
      },
      "operate": {
        "motionControlRoot": "C:\\ProgramData\\Siemens\\MotionControl",
        "softkeyOwnershipRoot": "C:\\ProgramData\\Gleason\\OperateSoftkeys",
        "softkeyStagingRoot": "D:\\OEM\\Temp\\OperateSoftkeys"
      }
    }
  }
}
